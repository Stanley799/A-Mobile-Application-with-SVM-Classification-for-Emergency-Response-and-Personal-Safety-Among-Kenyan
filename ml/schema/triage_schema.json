{
 "version": "3.1.0",
 "description": "Single source of truth for the triage questions, allowed values, scoring, rule floors, routing and hotlines. The Python scripts, the Flutter constants and the documentation are all generated from this file.",
 "not_asked": "NotAsked",
 "priorities": [
  "Low",
  "Medium",
  "High"
 ],
 "confidence_floor": 0.6,
 "high_threshold": 0.35,
 "review_near_high": 0.1,
 "review_near_high_note": "A case that the table rates below High but the model gives at least 10% High probability is flagged for human confirmation. In the all-combinations test this flag covered 88% of the cases the protocol rates High but the table rates Medium, while flagging about 3.6% of all combinations.",
 "high_threshold_note": "Safety bias: the case is treated as High when the model gives High at least 35% probability. Chosen from a sweep of 0.25 to 0.50 in cross-validation: it raised High recall from 0.88 to 0.93 at the cost of about 2.5% more over-triage. Undertriage is the more dangerous error.",
 "model_features": [
  "category",
  "age_group",
  "conscious",
  "breathing",
  "severe_bleeding",
  "chest_pain",
  "pregnant",
  "trapped",
  "hazard",
  "weapon_involved",
  "immediate_danger",
  "people_count"
 ],
 "questions": {
  "age_group": {
   "type": "enum",
   "values": [
    "Adult",
    "Child",
    "Unknown"
   ],
   "prompt": "Who needs help?",
   "labels": {
    "Adult": "Adult (13 or older)",
    "Child": "Child (12 or younger)",
    "Unknown": "Not sure"
   }
  },
  "conscious": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is the person awake and responding?"
  },
  "breathing": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is the person breathing normally?"
  },
  "severe_bleeding": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is there heavy bleeding that will not stop?"
  },
  "chest_pain": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is the person having chest pain or crushing pressure in the chest?"
  },
  "pregnant": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is the person pregnant?",
   "ask_if": {
    "age_group": [
     "Adult",
     "Unknown"
    ]
   }
  },
  "trapped": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is anyone trapped and unable to get out?"
  },
  "hazard": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is there fire, smoke, fuel leaking or danger of collapse?"
  },
  "weapon_involved": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is there a weapon (gun, knife, panga or similar)?"
  },
  "immediate_danger": {
   "type": "enum",
   "values": [
    "Yes",
    "No",
    "Unknown"
   ],
   "prompt": "Is the attacker or threat still close by?"
  },
  "people_count": {
   "type": "int",
   "min": 1,
   "max": 5,
   "prompt": "How many people need help? (5 means 5 or more)"
  }
 },

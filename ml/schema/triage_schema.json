 "subtype_rules": {
  "sexual_violence": {
   "confidential": true,
   "notify_trusted_contacts_by_default": false,
   "share_free_text_with_responder": false,
   "show_hotlines": [
    "1195"
   ],
   "note": "Survivor controls who is told. Never auto-notify contacts. Medical care is time-sensitive, so the priority floor is Medium."
  },
  "domestic_violence": {
   "confidential": true,
   "notify_trusted_contacts_by_default": false,
   "share_free_text_with_responder": false,
   "show_hotlines": [
    "1195"
   ],
   "note": "The abuser may be a trusted contact, so contacts are never notified by default."
  },
  "mental_health_crisis": {
   "confidential": true,
   "notify_trusted_contacts_by_default": true,
   "share_free_text_with_responder": false,
   "show_hotlines": [],
   "note": "Only for self-harm or suicide risk (safety flag or a Yes to the safety question). Always High and human triage. Show verified helplines only."
  },
  "missing_child": {
   "confidential": false,
   "notify_trusted_contacts_by_default": true,
   "share_free_text_with_responder": true,
   "show_hotlines": [],
   "note": ""
  },
  "emotional_distress": {
   "confidential": true,
   "notify_trusted_contacts_by_default": false,
   "share_free_text_with_responder": false,
   "show_hotlines": [],
   "note": "Heartbreak, stress, grief, worry or low mood WITHOUT any sign of self-harm. No priority floor (stays Low unless the answers say otherwise). The app must ask one safety question ('Are you thinking of harming yourself?'); a Yes switches to mental_health_crisis (always High). Contacts are not told by default because the resident may not want them to know. Show verified helplines only.",
   "dispatch_responder": false,
   "safety_question": "Are you thinking of harming yourself?"
  }
 },
